# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Email Configuration (SMTP)
# SMTP_HOST: 您的發信伺服器 (例如 Gmail 是 smtp.gmail.com)
SMTP_HOST=
# SMTP_PORT: 通常是 587
SMTP_PORT=
# SMTP_USER: 您的信箱帳號
SMTP_USER=
# SMTP_PASS: 您的信箱密碼 (如果是 Gmail，請使用「應用程式密碼」)
SMTP_PASS=
# FROM_EMAIL: 寄件者顯示的信箱
FROM_EMAIL=

# CRON_EMAILS: 每天晚上 9 點自動寄送的收件人信箱 (多個信箱請用逗號分隔)
CRON_EMAILS=r76021061@gmail.com

# ── 存取控制 (v3.4.0 新增) ──────────────────────────────────────────────────
# 保護 /api/config、/api/trigger-cron、/api/send-email、/api/run-pipeline
# 使用 HTTP Basic Auth，需在請求 Header 帶入 Authorization: Basic <base64(user:pass)>
INTERNAL_AUTH_USER=admin
INTERNAL_AUTH_PASS=your_secret_password

# ── 本機測試模式 (v3.4.0 新增) ──────────────────────────────────────────────
# 設定為 "true" 可關閉 30 分鐘 Cron Job，改用 POST /api/run-pipeline 手動觸發
# 正式上線時請移除此行或設為 "false"
DISABLE_CRON=false
